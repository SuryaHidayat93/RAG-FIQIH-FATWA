# Ollama LLM config
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=llama3.1:8b
COMPARISON_MODEL=qwen2.5:7b

# Embeddings & Reranker
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=./data/qdrant_storage
USE_LOCAL_QDRANT=true

# Search parameters
DENSE_TOP_K=15
BM25_TOP_K=15
RERANK_TOP_K=5
RRF_K=60
MAX_CRAG_RETRIES=1

# Server & UI
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
